// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch:extension",
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"label": "watch:webview",
			"type": "npm",
			"script": "watch:webview",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"problemMatcher": {
				"owner": "vite",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				},
				"background": {
					"activeBegin": true,
					"beginsPattern": "build started",
					"endsPattern": "built in"
				}
			}
		},
		{
			"label": "watch",
			"dependsOn": ["watch:extension", "watch:webview"],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
